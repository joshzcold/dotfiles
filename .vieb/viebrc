" Translated from ~/.config/qutebrowser (config.py + autoconfig.yml)
" Quickmarks live in quickmarks.viebrc, regenerate it with ~/.vieb/scripts/gen_quickmarks

" Look: ~/.config/Vieb/colors/qutebrowser.css
colorscheme qutebrowser
set guifontsize=13
set guitabbar=always guinavbar=always

" Options
set tabnewposition=end
set vimcommand="kitty --class=float -e nvim -u NONE"
set restoretabs=all
set nativetheme=dark
set nodarkreader
set adblocker=off
set useragent=["Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36"]
set searchengine=https://duckduckgo.com/?q=%s
set spelllang=en-US
set permissionclipboardread=allow
set permissionclipboardwrite=allow
set permissioncertificateerror=ask
set tabclosefocus=right
set permissionsallowed=["^https://app\\.chime\\.aws/~camera~mediadevices~microphone~notifications","^https://app\\.getgarner\\.com/~geolocation","^https://app\\.slack\\.com/~microphone~mediadevices~notifications","^https://app\\.zoom\\.us/~microphone~mediadevices~camera~notifications","^https://calendar\\.google\\.com/~notifications","^https://chat\\.google\\.com/~microphone~mediadevices~camera","^https://chat\\.gooogle\\.com/~notifications","^https://classic\\.minecraft\\.net/~pointerlock","^https://discord\\.com/~microphone~mediadevices","^https://drive\\.google\\.com/~notifications","^https://gemini\\.google\\.com/~notifications","^https://imperva\\.zoom\\.us/~microphone~mediadevices","^https://mail\\.google\\.com/~notifications","^https://meet\\.google\\.com/~microphone~mediadevices~camera~notifications","^https://messages\\.google\\.com/~notifications","^https://myhealthplusforms\\.intermountainhealthcare\\.org/~geolocation","^https://online-voice-recorder\\.com/~microphone~mediadevices","^https://outlook\\.office\\.com/~geolocation~notifications","^https://portal\\.superiorvision\\.com/~geolocation","^https://teams\\.microsoft\\.com/~microphone~mediadevices~camera~notifications","^https://us02web\\.zoom\\.us/~microphone~mediadevices~camera","^https://us04web\\.zoom\\.us/~microphone~mediadevices","^https://voice\\.google\\.com/~microphone~mediadevices~notifications","^https://web\\.whatsapp\\.com/~notifications","^https://www\\.bennish\\.net/~notifications","^https://www\\.cinemark\\.com/~geolocation","^https://www\\.dominos\\.com/~geolocation","^https://www\\.facebook\\.com/~microphone~mediadevices~camera","^https://www\\.google\\.com/~geolocation","^https://www\\.harborfreight\\.com/~geolocation","^https://www\\.homedepot\\.com/~geolocation","^https://www\\.ikea\\.com/~geolocation","^https://www\\.interstatebatteries\\.com/~geolocation","^https://www\\.lowes\\.com/~geolocation","^https://www\\.onlinemictest\\.com/~microphone~mediadevices","^https://www\\.orei