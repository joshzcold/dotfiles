#!/usr/bin/env python3
"""Regenerate ~/.vieb/quickmarks.viebrc from ~/.vieb/quickmarks (qutebrowser "name url" format)."""
import os
import re

base = os.path.expanduser("~/.vieb")
seen = set()
lines = ['" Generated by ~/.vieb/scripts/gen_quickmarks, edit ~/.vieb/quickmarks instead']
with open(f"{base}/quickmarks") as f:
    for line in f:
        line = line.strip()
        if not line or " " not in line:
            continue
        name, url = line.rsplit(" ", 1)
        slug = re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_")
        cmd = f"qm_{slug}"
        n = 2
        while cmd in seen:
            cmd = f"qm_{slug}_{n}"
            n += 1
        seen.add(cmd)
        lines.append(f"command! {cmd} <:open {url}>")
with open(f"{base}/quickmarks.viebrc", "w") as f:
    f.write("\n".join(lines) + "\n")
