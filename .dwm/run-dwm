#!/bin/bash
set -x

export PATH="$HOME/.nix-profile/bin:$PATH"
export XDG_DATA_DIRS="$HOME/.nix-profile/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

battery() {
  [ ! -f "/sys/class/power_supply/BAT0/capacity" ] && return
  local percent=$(cat /sys/class/power_supply/BAT0/capacity)
  local status=$(cat /sys/class/power_supply/BAT0/uevent | grep -o -P "(?<=POWER_SUPPLY_STATUS=).*")
  if [[ ! "$percent" = 100 ]]; then
    if [[ "$status" = "Charging" ]]; then
      echo "[bat ⚡ $percent%]"
    else
      if [[ $percent < 15 ]]; then
        echo "[bat $percent% LOW BATTERY !]"
      else
        echo "[bat $percent%]"
      fi
    fi
  fi
}

cpu() {
  # Each call runs in a command-substitution subshell, so the previous sample
  # has to live in a file rather than a variable.
  local state="${XDG_RUNTIME_DIR:-/tmp}/dwm-cpu-stat"
  local prev_total=0 prev_idle=0
  read -r _ user nice system idle iowait irq softirq steal _ </proc/stat
  local total=$((user + nice + system + idle + iowait + irq + softirq + steal))
  idle=$((idle + iowait))
  [ -f "$state" ] && read -r prev_total prev_idle <"$state"
  echo "$total $idle" >"$state"
  local total_diff=$((total - prev_total))
  [[ $total_diff -le 0 ]] && return
  local idle_diff=$((idle - prev_idle))
  echo "[cpu $((100 * (total_diff - idle_diff) / total_diff))%]"
}

memory() {
  local total=$(grep -o -P "(?<=^MemTotal:)\s*\d+" /proc/meminfo)
  local available=$(grep -o -P "(?<=^MemAvailable:)\s*\d+" /proc/meminfo)
  [[ -z $total || -z $available ]] && return
  echo "[mem $(((total - available) * 100 / total))%]"
}

vpn() {
  local vpn=$(nmcli c show --active | grep -P ".*?(?=[ \t]wireguard[ \t])" | awk -F '  ' '{print $1}')
  if [[ ! -z $vpn ]]; then
    echo "[vpn $vpn]"
  fi
}

wifi() {
  local wifi=$(nmcli c show --active | grep -P ".*?(?=[ \t]wifi.*)" | awk -F '  ' '{print $1}')
  if [[ ! -z $wifi ]]; then
    echo "[wifi $wifi]"
  fi
}

while true; do
  xsetroot -name "$(cpu) $(memory) $(battery) $(wifi) $(vpn) $(date +"%m-%d %r")"
  sleep 5 # Update time every 5 seconds
done &

while true; do
  # Log stderror to a file
  if command -v nixGL; then
    {
      echo "------------------------------"
      echo "Running dwm through nixGL"
      echo "------------------------------"
    } >>~/.dwm.log
    nixGL /usr/local/bin/dwm 2>>~/.dwm.log
  else
    {
      echo "------------------------------"
      echo "Running dwm"
      echo "------------------------------"
    } >>~/.dwm.log
    /usr/local/bin/dwm 2>>~/.dwm.log
  fi
  sleep 1
done
