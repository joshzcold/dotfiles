# TO USE THIS CONFIG FILE
# Either:
#   - copy this file to ~/.ssh/config.d/THIS_FILE
#       And put in:     Include: config.d/*
#   - copy the contents of this file into ~/.ssh/config
#
#   Be careful about what you put into your ~/.ssh/config
#
# SSH uses the first value it finds for each setting, so exceptions go above the defaults at the bottom.


Host hq-* dk-* sg-* *phv* *libvirt* *apphost*
    user joshua.cold
    identityfile ~/.ssh/id_rsa
    userknownhostsfile /dev/null
    stricthostkeychecking no
